# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js build output
/.next/
/out/
/build

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables
.env*.local
.env.development.local
.env.test.local
.env.production.local

# uploads & generated presentations
/uploads/*
!/uploads/.gitkeep
/generated/*
!/generated/.gitkeep

# font cache & temporary files
/public/fonts/*
!/public/fonts/.gitkeep
/scratch/

# python bytecode & virtualenvs
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
env/
venv/
